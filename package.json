{
  "license": "SEE LICENSE IN LICENSE",
  "name": "llms-forge",
  "version": "1.0.6",
  "description": "llm.energy - Extract documentation for AI agents from any site with llms.txt support",
  "private": false,
  "homepage": "https://llm.energy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/extract-llms-docs.git"
  },
  "bugs": {
    "url": "https://github.com/nirholas/extract-llms-docs/issues"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p ${PORT:-3001}",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "docs:install": "pip install -r docs-site/requirements.txt",
    "docs:dev": "cd docs-site && mkdocs serve",
    "docs:build": "cd docs-site && mkdocs build && rm -rf ../public/docs && cp -r site ../public/docs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react-syntax-highlighter": "^15.5.13",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "js-yaml": "^5.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.400.0",
    "nanoid": "^5.0.0",
    "next": "^16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vitest": "^4.0.17"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7": "^7.29.6",
      "baseline-browser-mapping@2": "^2.11.0",
      "brace-expansion@1": "^1.1.21",
      "browserslist@4": "^4.28.7",
      "flatted@3": "^3.4.2",
      "minimatch@10": "^11.0.1",
      "minimatch@3": "^3.1.3",
      "nanoid@3": "^3.3.12",
      "nanoid@5": "^5.1.16",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "postcss-selector-parser@6": "^6.1.5",
      "postcss@8": "^8.5.23",
      "rollup@4": "^4.59.0",
      "source-map-js@1": "^1.2.2",
      "vite@7": "^7.3.7",
      "ws@8": "^8.21.0",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1"
    }
  },
  "overrides": {
    "minimatch@^10": "^11.0.1"
  }
}
